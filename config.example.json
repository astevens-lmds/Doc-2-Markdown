    "use_tika": false,
    "use_tabula": true,
    "java_path": "",
    "rag_settings": {
        "enabled": true,
        "auto_vectorize": true,
        "embedding_provider": "openai",
        "embedding_model": "text-embedding-3-large",
        "vector_db_path": "./vector_db",
        "default_doc_type": "default",
        "chunk_overlap_pct": 0.12,
        "retrieval_k": 10,
        "hybrid_search": true
