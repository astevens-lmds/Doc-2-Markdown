    "monthly_budget": 30.0,
    "default_model": "google/gemini-2.5-flash",
    "use_ai_enhancement": true,
    "api_keys": {
        "openrouter": "",
        "openai": "",
        "anthropic": "",
        "google": ""
    },
    "use_ocr": false,
    "use_table_detection": true,
