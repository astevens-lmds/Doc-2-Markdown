# Doc-2-Markdown - Environment Variables
# Copy this file to .env and fill in your values
# Alternatively, configure via config.json (see config.example.json)

# API Keys (at least one required for AI enhancement)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# OCR (optional - for scanned PDFs)
# Requires Tesseract to be installed on your system
# TESSERACT_PATH=/usr/bin/tesseract

# Java (optional - for Tika/Tabula enhanced extraction)
# JAVA_HOME=/usr/lib/jvm/java-11
